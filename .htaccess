DirectoryIndex index.php index.html
Options -Indexes

RewriteEngine On

# Hidden files and folders (.git, .gitignore) are not for visitors.
RewriteRule (^|/)\.(?!well-known/) - [F]

# Generated for search engines.
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^robots\.txt$ robots.php [L]

# The old static pages now come from the PHP versions.
RewriteRule ^index\.html$ index.php [L,NC]
RewriteRule ^ux\.html$ ux.php [L,NC]
RewriteRule ^wordpress\.html$ wordpress.php [L,NC]

# Allow addresses without the extension, e.g. /ux
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^\.]+)$ $1.php [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^\.]+)$ $1.html [L]
